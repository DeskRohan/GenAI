   "source": [
    "from transformers import pipeline\n",
    "\n",
    "model = pipeline(\"sentiment-analysis\")\n",
    "\n",
    "texts = [\n",
    "    \"The phone is amazing\",\n",
    "    \"Worst service ever\"\n",
    "]\n",
    "\n",
    "results = model(texts)\n",
    "\n",
    "for t, r in zip(texts, results):\n",
    "    print(t)\n",
    "    print(r)"
   ]
  }
